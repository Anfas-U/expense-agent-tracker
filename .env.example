# ==============================================================================
# Expense Tracker Agent Configuration
# ==============================================================================

# LLM Provider Configuration
# Supported providers: anthropic, gemini
LLM_PROVIDER=gemini
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-2.5-flash

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Hosted multi-user web app. Use a private managed PostgreSQL URL (for example
# from Neon or Supabase); never commit the real URL or credentials.
DATABASE_URL=
# Keep true on HTTPS hosting. Set false only for local HTTP development.
COOKIE_SECURE=true

# Google Sheets Configuration
# Path to service_account.json or credentials.json
GOOGLE_CREDENTIALS_PATH=service_account.json
# Name or ID of the user's expense Google Spreadsheet
GOOGLE_SHEET_NAME=My Expense Tracker
GOOGLE_SHEET_ID=

# Locale & Currency Defaults
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata

# Local Storage Directory
DATA_DIR=data
RECEIPTS_DIR=data/receipts
DATABASE_PATH=data/expense_tracker.db
